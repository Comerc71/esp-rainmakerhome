# This `.xcode.env` file is versioned and is used to source the environment
# used when running script phases inside Xcode.
# To customize your local environment, you can create an `.xcode.env.local`
# file that is not versioned.

# NODE_BINARY variable contains the PATH to the node executable.
#
# Customize the NODE_BINARY variable here.
# For example, to use nvm with brew, add the following line
# . "$(brew --prefix nvm)/nvm.sh" --no-use
export NODE_BINARY=$(command -v node)

# Metro source map for symbolicating release JS stack traces — see
# docs/CRASH_SYMBOLICATION.md. Guarded on PROJECT_DIR: also sourced outside Xcode.
if [ -n "${PROJECT_DIR}" ]; then
  # Stamp the version into the filename. Crashlytics shows "6.0.1 (1)", so this
  # writes main.jsbundle.6.0.1-1.map: the matching map is obvious at a glance and
  # successive builds stop overwriting one another. Falls back rather than
  # producing "main.jsbundle..map" if either setting is somehow unset.
  _esp_ver="${MARKETING_VERSION:-unknown}"
  _esp_build="${CURRENT_PROJECT_VERSION:-0}"
  export SOURCEMAP_FILE="${SOURCEMAP_FILE:-${PROJECT_DIR}/build/main.jsbundle.${_esp_ver}-${_esp_build}.map}"
  mkdir -p "$(dirname "${SOURCEMAP_FILE}")" 2>/dev/null || true
fi
